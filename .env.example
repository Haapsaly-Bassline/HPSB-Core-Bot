# HPSB Core Bot — template. Copy to .env and fill in your values.
# Section order matches src/config.js. Empty = feature disabled.

# --- Discord core (required) ---
DISCORD_TOKEN=
CLIENT_ID=1342949712705224784
GUILD_ID=
MOD_ROLE_ID=
LOG_CHANNEL_ID=
ADMIN_DISCORD_IDS=

# --- Site integration (OAuth, future; not directly used by bot) ---
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://hpsbassline.club/api/auth/callback/discord
SESSION_SECRET=

# --- ModCall ---
MODCALL_CHANNEL_ID=1342958464355536967
MODCALL_STAFF_CHANNEL_ID=

# --- Automod (Carl-style) ---
AUTOMOD_FLOOD_COUNT=6
AUTOMOD_FLOOD_SECS=8
AUTOMOD_CAPS_MINLEN=12
AUTOMOD_CAPS_PCT=75
AUTOMOD_LINKS=on
AUTOMOD_LINK_WHITELIST=hpsbassline.club,azura.hpsbassline.club,youtube.com,youtu.be,spotify.com,soundcloud.com,bandcamp.com,audiomack.com,discord.gg,discord.com,streamable.com,reddit.com,github.com,google.com,tiktok.com,instagram.com,twitpic.com,cdn.discordapp.com,discordapp.net,tenor.com,giphy.com
AUTOMOD_INVITES=on
AUTOMOD_BADWORDS=
AUTOMOD_ACTION_HOURS=1

# --- Honeypot / trap ---
HONEYPOT_CHANNEL_ID=1552843652307492935
HONEYPOT_LOG_CHANNEL_ID=
# Public trap: first message in channel = punishment. timeout|kick|ban
HONEYPOT_ACTION=timeout
HONEYPOT_TIMEOUT_HOURS=12
# Banner for RF-style warning (image URL). Optional.
HONEYPOT_BANNER_URL=

# --- Anti-raid: join spike -> mute newcomers. 0 = off ---
ANTIRAID_JOINS=8
ANTIRAID_SECS=30
ANTIRAID_HOURS=1

# --- Music ---
# Spotify keys (for LavaSrc in lavalink/application.yml and legacy resolvers).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Music engine: lavalink (default) | hpsb (legacy custom)
MUSIC_ENGINE=lavalink
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
# Same password as lavalink/application.yml -> lavalink.server.password
LAVALINK_PASSWORD=
LAVALINK_SECURE=false
# Now Playing update interval, seconds (minimum 5)
NP_UPDATE_SECS=10

# --- Reposter: YT/TT/IG -> Discord ---
# Format: YT_CHANNEL_ID:DISCORD_CHANNEL_ID (TT: username:channelId), comma-separated
YOUTUBE_MAP=
# tiktok: username:discordChannelId
TIKTOK_MAP=
# instagram: username:discordChannelId
INSTAGRAM_MAP=
# Role ping for all announcements (media + news). Empty = no ping.
ANNOUNCE_ROLE_ID=
# Separate role for MEDIA (YT/IG/TT). Empty = general announce.
MEDIA_ROLE_ID=
REPOST_POLL_MINUTES=10
# Free YouTube Data API v3 key (console.cloud.google.com -> YouTube Data API v3 -> key).
# Without it bot falls back to RSS -> scrape; with it -> more accurate/stable.
YT_API_KEY=
# EN media post templates: {role} {author} {user} {title} {link}
YT_TEMPLATE={role} **{author}** uploaded a new video!
TT_TEMPLATE={role} **@{user}** posted on TikTok!
IG_TEMPLATE={role} **@{user}** posted on Instagram!
# Instagram without subscription: like other bots -- scrape public profile.
# Optionally speed up/stabilize with your session cookie or Graph API.
IG_SESSIONID=
IG_CSRFTOKEN=
IG_DID=
IG_GRAPH_TOKEN=
IG_BUSINESS_ID=

# --- HPSB APIs: ONE source per feed (JSON or RSS -- auto-detected) ---
HPSB_POLL_MINUTES=5
RELEASES_FEED_URL=https://release.hpsbassline.club/api/releases
RELEASES_CHANNEL_ID=
RELEASES_BASE_URL=https://release.hpsbassline.club
RELEASES_PAGE_BASE=https://hpsbassline.club/releases
EVENTS_FEED_URL=https://www.hpsbassline.club/api/feed/events.xml
EVENTS_CHANNEL_ID=
EVENTS_PAGE_BASE=https://hpsbassline.club/events
POSTS_API_URL=https://www.hpsbassline.club/api/posts
POSTS_CHANNEL_ID=
# Auto-crosspost announcements to subscribers (announcement channel IDs, comma-separated)
AUTOPUBLISH_CHANNEL_IDS=1342883584544997440
# legacy fallback (if you want everything in one channel -- put one ID in all three *_CHANNEL_ID)
SITE_API_URL=
SITE_API_KEY=
SITE_API_POLL_MINUTES=5
SITE_NEWS_CHANNEL_ID=

# --- Private voice rooms (VoiceMaster-style) ---
PRIV_GENERATOR_ID=1555650624912236645
PRIV_CATEGORY_ID=
PRIV_DEFAULT_LIMIT=0
PRIV_DEFAULT_BITRATE=64
PRIV_NAME_TEMPLATE={user}'s room

# --- Member Count parity: 9 counters + {count} templates ---
# Quick path: /counters setup (creates everything). Or put existing voice IDs.
STATS_INTERVAL_MIN=10
STATS_MEMBERS_CHANNEL_ID=
STATS_HUMANS_CHANNEL_ID=
STATS_BOTS_CHANNEL_ID=
STATS_ROLES_CHANNEL_ID=
STATS_CHANNELS_CHANNEL_ID=
STATS_ROLE_CHANNEL_ID=
STATS_ROLE_ID=
STATS_ONLINE_CHANNEL_ID=
STATS_OFFLINE_CHANNEL_ID=
STATS_BOOSTS_CHANNEL_ID=
STATS_MEMBERS_TEMPLATE=👥 Members: {count}
STATS_HUMANS_TEMPLATE=🧍 Users: {count}
STATS_BOTS_TEMPLATE=🤖 Bots: {count}
STATS_ROLES_TEMPLATE=🎭 Roles: {count}
STATS_CHANNELS_TEMPLATE=📁 Channels: {count}
STATS_ROLE_TEMPLATE=🎖 {count}
STATS_ONLINE_TEMPLATE=🟢 Online: {count}
STATS_OFFLINE_TEMPLATE=⚫ Offline: {count}
STATS_BOOSTS_TEMPLATE=💎 Boosts: {count}

# --- Webhook receiver: your services POST here (port not 3001-3006, reserved for mini-apps) ---
WEBHOOK_PORT=3100
WEBHOOK_SECRET=
WEBHOOK_NEWS_CHANNEL_ID=
# Public address for YouTube PubSubHubbub subscription (no trailing slash)
WEBHOOK_PUBLIC_BASE=https://hooks.hpsbassline.club
