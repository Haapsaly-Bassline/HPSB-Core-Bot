GUILD_ID=
MOD_ROLE_ID=
LOG_CHANNEL_ID=
ADMIN_DISCORD_IDS=743817824664944721

# --- Связка с сайтом (OAuth, на будущее; боту напрямую не нужны) ---
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://hpsbassline.club/api/auth/callback/discord
SESSION_SECRET=

# --- ModCall ---
MODCALL_CHANNEL_ID=1342958464355536967
MODCALL_STAFF_CHANNEL_ID=

# --- Automod (Carl-style) ---
AUTOMOD_FLOOD_COUNT=6
AUTOMOD_FLOOD_SECS=8
AUTOMOD_CAPS_MINLEN=12
AUTOMOD_CAPS_PCT=75
AUTOMOD_LINKS=on
AUTOMOD_LINK_WHITELIST=hpsbassline.club,azura.hpsbassline.club,youtube.com,youtu.be,spotify.com,soundcloud.com,bandcamp.com,audiomack.com,discord.gg,discord.com,instagram.com,tiktok.com
AUTOMOD_INVITES=on
AUTOMOD_BADWORDS=
AUTOMOD_ACTION_HOURS=1

# --- Member Count parity: 9 счётчиков + шаблоны {count} ---
# Быстрый путь: /counters setup (создаст всё сам). Либо впиши ID готовых войсов.
STATS_INTERVAL_MIN=10
STATS_MEMBERS_CHANNEL_ID=
STATS_HUMANS_CHANNEL_ID=
STATS_BOTS_CHANNEL_ID=
STATS_ROLES_CHANNEL_ID=
STATS_CHANNELS_CHANNEL_ID=
STATS_ROLE_CHANNEL_ID=
STATS_ROLE_ID=
STATS_ONLINE_CHANNEL_ID=
STATS_OFFLINE_CHANNEL_ID=
STATS_BOOSTS_CHANNEL_ID=
STATS_MEMBERS_TEMPLATE=👥 Members: {count}
STATS_HUMANS_TEMPLATE=🧍 Users: {count}
STATS_BOTS_TEMPLATE=🤖 Bots: {count}
STATS_ROLES_TEMPLATE=🎭 Roles: {count}
STATS_CHANNELS_TEMPLATE=📁 Channels: {count}
STATS_ROLE_TEMPLATE=🎖 {count}
STATS_ONLINE_TEMPLATE=🟢 Online: {count}
STATS_OFFLINE_TEMPLATE=⚫ Offline: {count}
STATS_BOOSTS_TEMPLATE=💎 Boosts: {count}

# --- Приватки (генератор войсов) ---
PRIV_GENERATOR_ID=1555650624912236645
PRIV_CATEGORY_ID=
PRIV_DEFAULT_LIMIT=0
PRIV_DEFAULT_BITRATE=64
PRIV_NAME_TEMPLATE={user}'s room

# --- Anti-raid: всплеск заходов (0 = выкл) ---
ANTIRAID_JOINS=8
ANTIRAID_SECS=30
ANTIRAID_HOURS=1

# --- Member Count: создай голосовые каналы, бот будет переименовывать ---
STATS_INTERVAL_MIN=15
STATS_MEMBERS_CHANNEL_ID=
STATS_HUMANS_CHANNEL_ID=
STATS_BOTS_CHANNEL_ID=
STATS_BOOSTS_CHANNEL_ID=
STATS_MEMBERS_LABEL=👥 Участники
STATS_HUMANS_LABEL=🧍 Люди
STATS_BOTS_LABEL=🤖 Боты
STATS_BOOSTS_LABEL=💎 Бусты

# --- Honeypot / Automod ---
HONEYPOT_CHANNEL_ID=1552843652307492935
HONEYPOT_LOG_CHANNEL_ID=
# Публичная ловушка: первое сообщение в канале = наказание. timeout|kick|ban
HONEYPOT_ACTION=timeout
HONEYPOT_TIMEOUT_HOURS=12
# Баннер для варнинга в стиле RF (URL картинки). Необязательно.
HONEYPOT_BANNER_URL=

# --- Music ---
# Свой движок hpsb; Spotify-ключи не нужны (embed-скрап без API).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Движок музыки: hpsb (сейчас) | lavalink (на host PC, см. lavalink/README.md)
MUSIC_ENGINE=hpsb
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=
LAVALINK_SECURE=false

# --- Reposter: YT/TT встроенные, Instagram — через Make-вебхук ---
# Формат: YT_CHANNEL_ID:DISCORD_CHANNEL_ID,через запятую
YOUTUBE_MAP=
# tiktok: username:discordChannelId
TIKTOK_MAP=
# Роль-пинг для всех объявлений (медиа + анонсы). Пусто = без пинга.
ANNOUNCE_ROLE_ID=
# Отдельная роль для МЕДИА (YT/IG/TT). Пусто = общая announce.
MEDIA_ROLE_ID=
# EN-шаблоны медиа-постов: {role} {author} {user} {title} {link}
YT_TEMPLATE={role} **{author}** uploaded a new video!
TT_TEMPLATE={role} **@{user}** posted on TikTok!
REPOST_POLL_MINUTES=10
# Бесплатный YouTube Data API v3 ключ (console.cloud.google.com → YouTube Data API v3 → ключ).
# Без него бот идёт по цепочке RSS → скрап, с ним — точнее и стабильнее.
YT_API_KEY=

# --- HPSB свои API: ОДИН источник на ленту (JSON или RSS — автоопределяется) ---
HPSB_POLL_MINUTES=5
RELEASES_FEED_URL=https://release.hpsbassline.club/api/releases
RELEASES_CHANNEL_ID=
RELEASES_BASE_URL=https://release.hpsbassline.club
RELEASES_PAGE_BASE=https://hpsbassline.club/releases
EVENTS_FEED_URL=https://www.hpsbassline.club/api/feed/events.xml
EVENTS_CHANNEL_ID=
EVENTS_PAGE_BASE=https://hpsbassline.club/events
POSTS_API_URL=https://www.hpsbassline.club/api/posts
POSTS_CHANNEL_ID=
# Автокросспост анонсов подписчикам (ID announcement-каналов через запятую)
AUTOPUBLISH_CHANNEL_IDS=1342883584544997440
# legacy fallback (если хочешь всё в один канал — укажи один ID во все три *_CHANNEL_ID)
SITE_API_URL=
SITE_API_KEY=
SITE_API_POLL_MINUTES=5
SITE_NEWS_CHANNEL_ID=

# Webhook-приёмник: ваши сервисы шлют POST сюда (порт не из 3001-3006, они за мини-прилами)
WEBHOOK_PORT=3100
# Публичный адрес для PubSubHubbub-подписки YouTube (без слэша в конце)
WEBHOOK_PUBLIC_BASE=https://hooks.hpsbassline.club
WEBHOOK_SECRET=
WEBHOOK_NEWS_CHANNEL_ID=
