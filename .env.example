# HPSB Music Bot — template. Copy to .env and fill in your values.

# --- Discord core (required) ---
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
# Shown in embed footers and /version
BOT_NAME=HPSB Music
# Optional: Discord user IDs that always pass /health and /perms gates
ADMIN_DISCORD_IDS=

# --- Lavalink node (required) ---
# Your Lavalink v4 server. It can be on another machine/VPS.
# Make sure port 2333 (or your port) is reachable from the bot host.
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
# Same password as on the Lavalink server (lavalink.server.password)
LAVALINK_PASSWORD=
# true when the node is behind TLS (wss/https)
LAVALINK_SECURE=false
# Node identifier in logs (free-form)
LAVALINK_NODE_ID=main
# Request timeout in ms (yt-dlp resolves can take ~15s)
LAVALINK_REQUEST_TIMEOUT_MS=30000

# --- Music defaults ---
# Text search source: youtube | soundcloud | spotify | deezer | applemusic | tidal | qobuz | yandex | vk
DEFAULT_SEARCH_SOURCE=youtube
# Now Playing refresh interval, seconds (minimum 5)
NP_UPDATE_SECS=10

# --- Lavalink server side only (NOT read by the bot) ---
# LavaSrc plugins need these in the Lavalink application.yml, not here:
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
