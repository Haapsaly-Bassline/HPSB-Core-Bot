# HPSB Core Bot — шаблон. Скопируй в .env и заполни свои значения.
# Порядок секций = порядку в src/config.js. Пусто = фича выключена (если не сказано иначе).
#
# ТИПЫ (первая строка над каждой переменной):
#   string       — любая строка. Пусто '' = выключено.
#   secret       — string, но секрет. Не коммитить, никому не показывать.
#   snowflake-id — ID Discord (только цифры: сервер/канал/роль). Пусто = выкл.
#   boolean      — on/true/1/yes = вкл; off/false/0/no = выкл. Пусто = дефолт.
#   integer      — целое число. Пусто = дефолт.
#   list         — список через запятую: "a,b,c". Пусто = пустой список.
#   map          — пары "ключ:значение" через запятую. Пусто = пустой список.
#   url          — ссылка http(s)://. Пусто = выкл.
#   template     — строка с плейсхолдерами {role} {author} {user} {title} {link} {count} {user}.

# --- Модули on/off ---
# тип: boolean | дефолт: on (пусто = включено)
MODULE_MUSIC=on
MODULE_PUBLISHER=on
MODULE_AUTOMOD=on
MODULE_HONEYPOT=on
MODULE_MODCALL=on
MODULE_STATS=on
MODULE_PRIVATE=on

# --- Publisher: куда постить (новый Publisher; старые *_CHANNEL_ID ниже — fallback) ---
# тип: snowflake-id | пусто = выключено
ANNOUNCEMENTS_CHANNEL_ID=
MEDIA_CHANNEL_ID=
PARTNERS_CHANNEL_ID=

# --- Publisher: источники (все включены по умолчанию, тумблер на каждый) ---
# тип: boolean | дефолт: on
PUBLISHER_YOUTUBE=on
PUBLISHER_TWITCH=on
PUBLISHER_INSTAGRAM=on
PUBLISHER_TIKTOK=on
PUBLISHER_HPSB=on

# --- YouTube (новый Publisher) ---
# тип: url | пусто = выкл (ссылка на стрим/канал для кнопки Live)
YOUTUBE_LIVE_URL=

# --- Twitch EventSub (новый Publisher) ---
# тип: secret/snowflake-id/url | пусто = Twitch выключен
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BROADCASTER_ID=
TWITCH_URL=
TWITCH_EVENTSUB_SECRET=

# --- Instagram (новый Publisher, официальный API) ---
# тип: secret | пусто = Instagram API выключен
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_WEBHOOK_SECRET=

# --- TikTok (новый Publisher, официальный API) ---
# тип: secret | пусто = TikTok API выключен
TIKTOK_ACCESS_TOKEN=
# тип: integer | дефолт: 5 (минут между опросами)
TIKTOK_POLL_MINUTES=5

# --- HPSB фиды (новый Publisher; API основной, RSS запасной) ---
# тип: url | дефолты ниже
HPSB_EVENTS_API_URL=https://events.hpsbassline.club/api/events
HPSB_EVENTS_RSS_URL=https://www.hpsbassline.club/api/feed/events.xml
HPSB_RELEASES_API_URL=https://rls.hpsbassline.club/api/releases
HPSB_RELEASES_RSS_URL=https://www.hpsbassline.club/api/feed/releases.xml
HPSB_NEWS_RSS_URL=https://www.hpsbassline.club/api/feed/news.xml

# --- Discord core (обязательно) ---
# тип: secret | обязательно, без него бот не стартует
DISCORD_TOKEN=
# тип: snowflake-id | обязательно (ID приложения из Discord Developer Portal)
CLIENT_ID=1342949712705224784
# тип: snowflake-id | обязательно (ID твоего сервера)
GUILD_ID=
# тип: snowflake-id | роль модератора (доступ к /ban /mute и т.д.)
MOD_ROLE_ID=
# тип: snowflake-id | пусто = логи выключены
LOG_CHANNEL_ID=
# тип: list<snowflake-id> | пример: "123,456" | пусто = нет суперадминов
ADMIN_DISCORD_IDS=

# --- Сайт OAuth (на будущее; бот напрямую не использует) ---
# тип: secret/url
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://hpsbassline.club/api/auth/callback/discord
SESSION_SECRET=

# --- ModCall (кнопка "позвать модера") ---
# тип: snowflake-id | пусто = ModCall выключен
MODCALL_CHANNEL_ID=1342958464355536967
MODCALL_STAFF_CHANNEL_ID=

# --- Automod (как Carl-bot) ---
# тип: integer | дефолт: 6 (N сообщений...)
AUTOMOD_FLOOD_COUNT=6
# тип: integer | дефолт: 8 (...за N секунд = флуд)
AUTOMOD_FLOOD_SECS=8
# тип: integer | дефолт: 12 (проверять CAPS только если сообщение длиннее N)
AUTOMOD_CAPS_MINLEN=12
# тип: integer | дефолт: 75 (% заглавных = капс)
AUTOMOD_CAPS_PCT=75
# тип: boolean | дефолт: on (удалять ссылки не из whitelist)
AUTOMOD_LINKS=on
# тип: list<string> доменов | дефолт: список ниже
AUTOMOD_LINK_WHITELIST=hpsbassline.club,azura.hpsbassline.club,youtube.com,youtu.be,spotify.com,soundcloud.com,bandcamp.com,audiomack.com,discord.gg,discord.com,streamable.com,reddit.com,github.com,google.com,tiktok.com,instagram.com,twitpic.com,cdn.discordapp.com,discordapp.net,tenor.com,giphy.com
# тип: boolean | дефолт: on (удалять discord-инвайты на чужие серверы)
AUTOMOD_INVITES=on
# тип: list<string> | пусто = нет запрещённых слов, пример: "spam,badword"
AUTOMOD_BADWORDS=
# тип: integer | дефолт: 1 (мут за нарушения на N часов)
AUTOMOD_ACTION_HOURS=1

# --- Honeypot-ловушка (канал-приманка) ---
# тип: snowflake-id | пусто = ловушка выключена
HONEYPOT_CHANNEL_ID=1552843652307492935
HONEYPOT_LOG_CHANNEL_ID=
# тип: timeout|kick|ban | дефолт: timeout (timeout = мут, kick = кик, ban = бан)
HONEYPOT_ACTION=timeout
# тип: integer | дефолт: 12 (мут на N часов, только для timeout)
HONEYPOT_TIMEOUT_HOURS=12
# тип: url | пусто = красочный эмбед без картинки (ссылка на картинку-предупреждение)
HONEYPOT_BANNER_URL=

# --- Anti-raid: всплеск заходов -> мут новичков. 0 = выкл ---
# тип: integer | дефолт: 8 (N заходов...)
ANTIRAID_JOINS=8
# тип: integer | дефолт: 30 (...за N секунд...)
ANTIRAID_SECS=30
# тип: integer | дефолт: 1 (...= мут новичков на N часов)
ANTIRAID_HOURS=1

# --- Music (Lavalink) ---
# тип: secret | пусто = Spotify-резолв выключен (дублируются в lavalink/application.yml)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# тип: string | дефолт: lavalink (только lavalink, legacy удалён)
MUSIC_ENGINE=lavalink
# тип: string | дефолт: 127.0.0.1
LAVALINK_HOST=127.0.0.1
# тип: integer | дефолт: 2333
LAVALINK_PORT=2333
# тип: secret | обязательно (= lavalink.server.password в lavalink/application.yml)
LAVALINK_PASSWORD=
# тип: boolean | дефолт: off (true = wss/https)
LAVALINK_SECURE=false
# тип: integer | дефолт: 10, минимум 5 (обновление Now Playing, секунд)
NP_UPDATE_SECS=10

# --- Reposter: YT/TT/IG -> Discord (старый модуль) ---
# тип: map | формат "YT_CHANNEL_ID:DISCORD_CHANNEL_ID,..." | пусто = выкл
YOUTUBE_MAP=
# тип: map | формат "username:discordChannelId,..." | пусто = выкл
TIKTOK_MAP=
# тип: map | формат "username:discordChannelId,..." | пусто = выкл
INSTAGRAM_MAP=
# тип: snowflake-id | пусто = без пинга (роль для ВСЕХ анонсов: медиа + новости)
ANNOUNCE_ROLE_ID=
# тип: snowflake-id | пусто = используется ANNOUNCE_ROLE_ID (отдельная роль для МЕДИА YT/IG/TT)
MEDIA_ROLE_ID=
# тип: integer | дефолт: 10 (опрос источников, минут)
REPOST_POLL_MINUTES=10
# тип: secret | пусто = fallback RSS->scrape (бесплатный YouTube Data API v3 ключ = точнее)
YT_API_KEY=
# тип: template | плейсхолдеры: {role} {author} {user} {title} {link}
YT_TEMPLATE={role} **{author}** uploaded a new video!
TT_TEMPLATE={role} **@{user}** posted on TikTok!
IG_TEMPLATE={role} **@{user}** posted on Instagram!
# Instagram-скрап без подписки (cookie своей сессии; либо Graph API ниже).
# тип: secret | пусто = обычный скрап
IG_SESSIONID=
IG_CSRFTOKEN=
IG_DID=
IG_GRAPH_TOKEN=
IG_BUSINESS_ID=

# --- HPSB API сайта: ОДИН источник на ленту (JSON или RSS — автоопределение) ---
# тип: integer | дефолт: 5 (опрос фидов, минут)
HPSB_POLL_MINUTES=5
# тип: url | лента релизов
RELEASES_FEED_URL=https://release.hpsbassline.club/api/releases
# тип: snowflake-id | пусто = релизы выключены (fallback: SITE_NEWS_CHANNEL_ID)
RELEASES_CHANNEL_ID=
# тип: url | без слэша в конце
RELEASES_BASE_URL=https://release.hpsbassline.club
RELEASES_PAGE_BASE=https://hpsbassline.club/releases
# тип: url | лента событий
EVENTS_FEED_URL=https://www.hpsbassline.club/api/feed/events.xml
# тип: snowflake-id | пусто = события выключены (fallback: SITE_NEWS_CHANNEL_ID)
EVENTS_CHANNEL_ID=
EVENTS_PAGE_BASE=https://hpsbassline.club/events
# тип: url | лента постов/новостей
POSTS_API_URL=https://www.hpsbassline.club/api/posts
# тип: snowflake-id | пусто = посты выключены (fallback: SITE_NEWS_CHANNEL_ID)
POSTS_CHANNEL_ID=
# тип: list<snowflake-id> | автокросспост анонсов подписчикам (ID announcement-каналов)
AUTOPUBLISH_CHANNEL_IDS=1342883584544997440
# legacy single-feed (совместимость; сейчас всё идёт через HPSB_* выше)
# тип: url/secret/integer/snowflake-id
SITE_API_URL=
SITE_API_KEY=
SITE_API_POLL_MINUTES=5
SITE_NEWS_CHANNEL_ID=

# --- Приватные голосовые (как VoiceMaster) ---
# тип: snowflake-id | пусто = приватки выключены (войс-генератор: зашёл -> своя комната)
PRIV_GENERATOR_ID=1555650624912236645
# тип: snowflake-id | пусто = создавать рядом (категория для приватных комнат)
PRIV_CATEGORY_ID=
# тип: integer | дефолт: 0 (0 = без лимита)
PRIV_DEFAULT_LIMIT=0
# тип: integer | дефолт: 64 (кбит/с)
PRIV_DEFAULT_BITRATE=64
# тип: template | плейсхолдер {user}
PRIV_NAME_TEMPLATE={user}'s room

# --- Счётчики онлайна: 9 штук + шаблоны с {count}. Быстрый путь: /counters setup ---
# тип: integer | дефолт: 10 (обновление, минут)
STATS_INTERVAL_MIN=10
# тип: snowflake-id | пусто = этот счётчик выкл (ID голосового канала-счётчика)
STATS_MEMBERS_CHANNEL_ID=
STATS_HUMANS_CHANNEL_ID=
STATS_BOTS_CHANNEL_ID=
STATS_ROLES_CHANNEL_ID=
STATS_CHANNELS_CHANNEL_ID=
STATS_ROLE_CHANNEL_ID=
# тип: snowflake-id | какую роль считать для STATS_ROLE_*
STATS_ROLE_ID=
STATS_ONLINE_CHANNEL_ID=
STATS_OFFLINE_CHANNEL_ID=
STATS_BOOSTS_CHANNEL_ID=
# тип: template | плейсхолдер {count}
STATS_MEMBERS_TEMPLATE=👥 Members: {count}
STATS_HUMANS_TEMPLATE=🧍 Users: {count}
STATS_BOTS_TEMPLATE=🤖 Bots: {count}
STATS_ROLES_TEMPLATE=🎭 Roles: {count}
STATS_CHANNELS_TEMPLATE=📁 Channels: {count}
STATS_ROLE_TEMPLATE=🎖 {count}
STATS_ONLINE_TEMPLATE=🟢 Online: {count}
STATS_OFFLINE_TEMPLATE=⚫ Offline: {count}
STATS_BOOSTS_TEMPLATE=💎 Boosts: {count}

# --- Webhook-приёмник: внешние сервисы шлют POST сюда ---
# тип: integer | дефолт: 3100 (не 3001-3006, они для мини-приложений)
WEBHOOK_PORT=3100
# тип: secret | подпись запросов
WEBHOOK_SECRET=
# тип: snowflake-id | пусто = webhook выключен
WEBHOOK_NEWS_CHANNEL_ID=
# тип: url без слэша | публичный адрес для YouTube PubSubHubbub-подписки
WEBHOOK_PUBLIC_BASE=https://hooks.hpsbassline.club
